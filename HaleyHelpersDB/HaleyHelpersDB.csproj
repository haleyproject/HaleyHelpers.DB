<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HaleyProject Condition="'$(HaleyProject)' == ''">$(MSBuildProjectDirectory)\..\..</HaleyProject>
  </PropertyGroup>
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Source.Props" />
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Version.Props" />
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Paths.Props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Haley</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <AssemblyName>Haley.Helpers.DB</AssemblyName>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\HaleyProject\HaleyProject.snk</AssemblyOriginatorKeyFile>
    <PackageIcon>Haley.png</PackageIcon>
    <Version>$(HaleyHelpersDBVersion)</Version>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>$(ProjectBaseUrl)Helpers.DB</PackageProjectUrl>
    <RepositoryUrl>$(ProjectBaseUrl)Helpers.DB</RepositoryUrl>
    <Description>A simple tool to help connect to different Database providers via single window. It has has other cool features</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Added the breaking gateway.BootstrapDatabaseAsync contract with idempotent MariaDB and PostgreSQL bootstrap handlers.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Models\Storage\**" />
    <EmbeddedResource Remove="Models\Storage\**" />
    <None Remove="Models\Storage\**" />
  </ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
		<DebugType>full</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<WarningLevel>2</WarningLevel>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

  <ItemGroup>
    <Compile Remove="Utils\AdapterGateway\AdapterGateway.Old.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\HaleyProject\Haley.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- DiagnosticSource 11 falls back to a netstandard asset on net8.0 whose init setter is incompatible with Npgsql metrics. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.15" />
  </ItemGroup>
  <Choose>
    <When Condition="Exists('$(HaleyAbstractionsCoreProj)')">
      <ItemGroup>
        <ProjectReference Include="$(HaleyAbstractionsCoreProj)">
          <Name>HaleyAbstractionsCore</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Haley.Abstractions.Core" Version="$(HaleyAbstractionsCoreVersion)" />
      </ItemGroup>
    </Otherwise>
  </Choose>
  <Choose>
    <When Condition="Exists('$(HaleyHelpersProj)')">
      <ItemGroup>
        <ProjectReference Include="$(HaleyHelpersProj)">
          <Name>HaleyHelpers</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Haley.Helpers" Version="$(HaleyHelpersVersion)" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
